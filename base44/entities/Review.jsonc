{
  "name": "Review",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "title": "Product ID"
    },
    "rating": {
      "type": "integer",
      "title": "Rating",
      "minimum": 1,
      "maximum": 5
    },
    "name": {
      "type": "string",
      "title": "Name"
    },
    "comment": {
      "type": "string",
      "title": "Comment"
    },
    "photo_url": {
      "type": "string",
      "title": "Customer photo URL",
      "format": "uri"
    },
    "status": {
      "type": "string",
      "title": "Photo approval status",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ]
    },
    "user_id": {
      "type": "string",
      "title": "Customer ID"
    },
    "user_email": {
      "type": "string",
      "title": "Customer email"
    },
    "reward_granted": {
      "type": "boolean",
      "title": "Loyalty reward granted",
      "default": false
    },
    "reviewed_by": {
      "type": "string",
      "title": "Reviewed by"
    },
    "review_note": {
      "type": "string",
      "title": "Admin review note",
      "maxLength": 1000
    },
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    }
  },
  "required": [
    "product_id",
    "rating",
    "name",
    "comment"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}