{
  "name": "LoyaltyAccount",
  "type": "object",
  "properties": {
    "wallet_code": {
      "type": "string",
      "title": "Wallet ID"
    },
    "user_id": {
      "type": "string",
      "title": "Customer ID"
    },
    "user_email": {
      "type": "string",
      "title": "Customer email"
    },
    "user_name": {
      "type": "string",
      "title": "Customer name"
    },
    "user_phone": {
      "type": "string",
      "title": "Customer phone"
    },
    "balance": {
      "type": "integer",
      "title": "Available points",
      "default": 0
    },
    "pending_points": {
      "type": "integer",
      "title": "Pending points",
      "default": 0
    },
    "lifetime_earned": {
      "type": "integer",
      "title": "Lifetime earned",
      "default": 0
    },
    "lifetime_spent": {
      "type": "integer",
      "title": "Lifetime redeemed",
      "default": 0
    },
    "lifetime_removed": {
      "type": "integer",
      "title": "Total removed/reversed",
      "default": 0
    },
    "expired_points": {
      "type": "integer",
      "title": "Total expired",
      "default": 0
    },
    "status": {
      "type": "string",
      "title": "Wallet status",
      "enum": [
        "active",
        "frozen",
        "suspended"
      ],
      "default": "active"
    },
    "frozen": {
      "type": "boolean",
      "title": "Blocked (legacy flag)",
      "default": false
    },
    "last_activity_at": {
      "type": "string",
      "title": "Last activity"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}