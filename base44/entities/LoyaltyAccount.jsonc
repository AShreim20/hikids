{
  "name": "LoyaltyAccount",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "User ID"
    },
    "user_email": {
      "type": "string",
      "title": "User email"
    },
    "user_name": {
      "type": "string",
      "title": "User name"
    },
    "balance": {
      "type": "integer",
      "title": "Available balance",
      "default": 0
    },
    "lifetime_earned": {
      "type": "integer",
      "title": "Total earned",
      "default": 0
    },
    "lifetime_spent": {
      "type": "integer",
      "title": "Total spent",
      "default": 0
    },
    "lifetime_removed": {
      "type": "integer",
      "title": "Total removed/reversed",
      "default": 0
    },
    "expired_points": {
      "type": "integer",
      "title": "Total expired",
      "default": 0
    },
    "frozen": {
      "type": "boolean",
      "title": "Wallet frozen",
      "default": false
    },
    "last_activity_at": {
      "type": "string",
      "title": "Last activity"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}