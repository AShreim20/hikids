{
  "name": "LoyaltyTransaction",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "title": "Wallet ID"
    },
    "user_id": {
      "type": "string",
      "title": "Customer ID"
    },
    "user_email": {
      "type": "string",
      "title": "Customer email"
    },
    "points": {
      "type": "integer",
      "title": "Points (signed)"
    },
    "type": {
      "type": "string",
      "title": "Type",
      "enum": [
        "earn",
        "redeem",
        "refund",
        "reversal",
        "adjust",
        "expire"
      ]
    },
    "reason": {
      "type": "string",
      "title": "Reason"
    },
    "order_id": {
      "type": "string",
      "title": "Related order"
    },
    "balance_before": {
      "type": "integer",
      "title": "Balance before"
    },
    "balance_after": {
      "type": "integer",
      "title": "Balance after"
    },
    "actor_email": {
      "type": "string",
      "title": "Performed by"
    },
    "idempotency_key": {
      "type": "string",
      "title": "Idempotency key"
    },
    "expires_at": {
      "type": "string",
      "title": "Expires at"
    }
  },
  "required": [
    "user_email",
    "points",
    "type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}