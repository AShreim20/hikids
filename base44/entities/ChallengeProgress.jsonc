{
  "name": "ChallengeProgress",
  "type": "object",
  "properties": {
    "challenge_id": {
      "type": "string",
      "title": "Challenge"
    },
    "user_id": {
      "type": "string",
      "title": "Customer ID"
    },
    "user_email": {
      "type": "string",
      "title": "Customer email"
    },
    "completions": {
      "type": "integer",
      "title": "Completions",
      "default": 0
    },
    "rewarded_count": {
      "type": "integer",
      "title": "Rewards claimed",
      "default": 0
    },
    "last_completed_at": {
      "type": "string",
      "title": "Last completion"
    },
    "recipients": {
      "type": "array",
      "title": "Verified share recipients",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "rewarded_order_ids": {
      "type": "array",
      "title": "Orders already rewarded",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "title": "Status",
      "default": "active"
    }
  },
  "required": [
    "challenge_id",
    "user_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}