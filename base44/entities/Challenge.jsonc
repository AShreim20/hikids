{
  "name": "Challenge",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 2000
    },
    "type": {
      "type": "string",
      "title": "Challenge type",
      "enum": [
        "product_purchase",
        "spend_amount",
        "purchase_count",
        "photo_upload",
        "share",
        "custom"
      ],
      "default": "custom"
    },
    "target": {
      "type": "object",
      "title": "Target / requirement",
      "properties": {
        "product_id": {
          "type": "string"
        },
        "product_name": {
          "type": "string"
        },
        "amount": {
          "type": "number"
        },
        "count": {
          "type": "integer"
        },
        "share_count": {
          "type": "integer"
        }
      }
    },
    "reward_type": {
      "type": "string",
      "title": "Reward type",
      "enum": [
        "points",
        "discount_percent",
        "discount_fixed",
        "free_delivery",
        "product",
        "credit"
      ],
      "default": "points"
    },
    "reward_value": {
      "type": "number",
      "title": "Reward value",
      "default": 0
    },
    "reward_label": {
      "type": "string",
      "title": "Reward label"
    },
    "product_id": {
      "type": "string",
      "title": "Product reward id"
    },
    "reward_code_prefix": {
      "type": "string",
      "title": "Discount code prefix",
      "default": "CHL"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "Start date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "title": "End date"
    },
    "active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    },
    "frequency": {
      "type": "string",
      "title": "Frequency",
      "enum": [
        "once",
        "daily",
        "weekly",
        "monthly",
        "unlimited",
        "custom"
      ],
      "default": "once"
    },
    "limit_count": {
      "type": "integer",
      "title": "Custom limit",
      "default": 1
    },
    "requires_review": {
      "type": "boolean",
      "title": "Requires manual review",
      "default": false
    },
    "created_by_email": {
      "type": "string",
      "title": "Created by"
    }
  },
  "required": [
    "name",
    "type",
    "reward_type"
  ],
  "rls": {
    "read": null,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}