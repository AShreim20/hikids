{
  "name": "WheelProgress",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "Customer ID"
    },
    "user_email": {
      "type": "string",
      "title": "Customer email"
    },
    "eligible_amount": {
      "type": "number",
      "title": "Eligible spend",
      "default": 0
    },
    "spins_earned": {
      "type": "integer",
      "title": "Spins earned",
      "default": 0
    },
    "spins_used": {
      "type": "integer",
      "title": "Spins used",
      "default": 0
    },
    "free_spin_granted": {
      "type": "boolean",
      "title": "First-time spin granted",
      "default": false
    },
    "last_order_id": {
      "type": "string",
      "title": "Last counted order"
    },
    "last_activity_at": {
      "type": "string",
      "title": "Last activity"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}