{
  "name": "WheelSpin",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "Customer ID"
    },
    "user_email": {
      "type": "string",
      "title": "Customer email"
    },
    "source": {
      "type": "string",
      "title": "Source",
      "enum": [
        "purchase",
        "firsttime"
      ],
      "default": "purchase"
    },
    "order_id": {
      "type": "string",
      "title": "Order"
    },
    "reward_id": {
      "type": "string",
      "title": "Wheel reward"
    },
    "reward_type": {
      "type": "string",
      "title": "Reward type"
    },
    "reward_label": {
      "type": "string",
      "title": "Reward label (Arabic)"
    },
    "reward_label_en": {
      "type": "string",
      "title": "Reward label (English)"
    },
    "reward_value": {
      "type": "number",
      "title": "Reward value",
      "default": 0
    },
    "product_id": {
      "type": "string",
      "title": "Product"
    },
    "product_name": {
      "type": "string",
      "title": "Product name (Arabic)"
    },
    "product_name_en": {
      "type": "string",
      "title": "Product name (English)"
    },
    "product_image": {
      "type": "string",
      "title": "Product image",
      "format": "uri"
    },
    "product_price": {
      "type": "number",
      "title": "Product normal price",
      "default": 0
    },
    "points_awarded": {
      "type": "integer",
      "title": "Points awarded",
      "default": 0
    },
    "discount_code": {
      "type": "string",
      "title": "Discount code"
    },
    "discount_code_id": {
      "type": "string",
      "title": "Discount code record"
    },
    "customer_name": {
      "type": "string",
      "title": "Customer name"
    },
    "customer_phone": {
      "type": "string",
      "title": "Customer phone"
    },
    "status": {
      "type": "string",
      "title": "Redemption status",
      "enum": [
        "unused",
        "used",
        "expired",
        "unavailable"
      ],
      "default": "unused"
    },
    "redeemed_order_id": {
      "type": "string",
      "title": "Redeemed in order"
    },
    "expires_at": {
      "type": "string",
      "title": "Expires at"
    },
    "fulfillment": {
      "type": "string",
      "title": "Fulfillment",
      "enum": [
        "auto",
        "manual"
      ],
      "default": "auto"
    }
  },
  "required": [
    "user_email",
    "reward_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}