{
  "name": "SiteContent",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "title": "Content key",
      "description": "Logical identifier, e.g. i18n_overrides, faq_items, about"
    },
    "data": {
      "type": "object",
      "title": "Content data",
      "additionalProperties": true
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "read": null,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}