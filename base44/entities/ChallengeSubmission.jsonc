{
  "name": "ChallengeSubmission",
  "type": "object",
  "properties": {
    "challenge_id": {
      "type": "string",
      "title": "Challenge"
    },
    "challenge_name": {
      "type": "string",
      "title": "Challenge name"
    },
    "user_id": {
      "type": "string",
      "title": "Customer ID"
    },
    "user_email": {
      "type": "string",
      "title": "Customer email"
    },
    "file_url": {
      "type": "string",
      "title": "Photo",
      "format": "uri"
    },
    "note": {
      "type": "string",
      "title": "Customer note",
      "maxLength": 1000
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "reviewed_by": {
      "type": "string",
      "title": "Reviewed by"
    },
    "review_note": {
      "type": "string",
      "title": "Review note",
      "maxLength": 1000
    },
    "reward_granted": {
      "type": "boolean",
      "title": "Reward granted",
      "default": false
    }
  },
  "required": [
    "challenge_id",
    "user_email",
    "file_url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}