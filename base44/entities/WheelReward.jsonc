{
  "name": "WheelReward",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "title": "Label"
    },
    "type": {
      "type": "string",
      "title": "Reward type",
      "enum": [
        "points",
        "discount_percent",
        "discount_fixed",
        "free_delivery",
        "product",
        "credit"
      ],
      "default": "points"
    },
    "value": {
      "type": "number",
      "title": "Value",
      "default": 0
    },
    "product_id": {
      "type": "string",
      "title": "Product (for product rewards)"
    },
    "product_name": {
      "type": "string",
      "title": "Product name"
    },
    "weight": {
      "type": "number",
      "title": "Probability weight",
      "default": 1
    },
    "active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    },
    "sort_order": {
      "type": "integer",
      "title": "Sort order",
      "default": 0
    }
  },
  "required": [
    "label",
    "type",
    "weight"
  ],
  "rls": {
    "read": null,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}