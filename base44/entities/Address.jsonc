{
  "name": "Address",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "title": "Label",
      "default": "Home"
    },
    "recipient_name": {
      "type": "string",
      "title": "Recipient name"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "city": {
      "type": "string",
      "title": "City"
    },
    "street": {
      "type": "string",
      "title": "Street address"
    },
    "details": {
      "type": "string",
      "title": "Details"
    },
    "is_default": {
      "type": "boolean",
      "title": "Default",
      "default": false
    }
  },
  "required": [
    "recipient_name",
    "phone",
    "city",
    "street"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}