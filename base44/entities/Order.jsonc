{
  "name": "Order",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "title": "Items",
      "items": {
        "type": "object"
      }
    },
    "total": {
      "type": "number",
      "title": "Total"
    },
    "subtotal": {
      "type": "number",
      "title": "Subtotal"
    },
    "delivery_cost": {
      "type": "number",
      "title": "Delivery cost",
      "default": 0
    },
    "city": {
      "type": "string",
      "title": "City"
    },
    "customer_name": {
      "type": "string",
      "title": "Customer Name"
    },
    "customer_email": {
      "type": "string",
      "title": "Customer Email"
    },
    "address": {
      "type": "string",
      "title": "Address"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "payment_method": {
      "type": "string",
      "title": "Payment Method",
      "enum": [
        "card",
        "cod"
      ]
    },
    "gift_message": {
      "type": "string",
      "title": "Gift Message"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "default": "pending",
      "enum": [
        "pending",
        "paid",
        "shipped",
        "delivered",
        "cancelled"
      ]
    }
  },
  "required": [
    "customer_name",
    "customer_email",
    "address",
    "phone",
    "payment_method",
    "city"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}