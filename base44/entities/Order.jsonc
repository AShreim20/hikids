{
  "name": "Order",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "title": "Items",
      "items": {
        "type": "object"
      }
    },
    "total": {
      "type": "number",
      "title": "Total"
    },
    "subtotal": {
      "type": "number",
      "title": "Subtotal"
    },
    "delivery_cost": {
      "type": "number",
      "title": "Delivery cost",
      "default": 0
    },
    "discount_code": {
      "type": "string",
      "title": "Discount code"
    },
    "discount_amount": {
      "type": "number",
      "title": "Discount amount",
      "default": 0
    },
    "loyalty_points": {
      "type": "integer",
      "title": "Loyalty points redeemed",
      "default": 0
    },
    "loyalty_discount": {
      "type": "number",
      "title": "Loyalty discount",
      "default": 0
    },
    "loyalty_redeem_key": {
      "type": "string",
      "title": "Redemption idempotency key"
    },
    "loyalty_pending_points": {
      "type": "integer",
      "title": "Pending points accrued",
      "default": 0
    },
    "loyalty_awarded": {
      "type": "boolean",
      "title": "Loyalty awarded",
      "default": false
    },
    "loyalty_reversed": {
      "type": "boolean",
      "title": "Loyalty reversed",
      "default": false
    },
    "loyalty_released": {
      "type": "boolean",
      "title": "Reserved points released",
      "default": false
    },
    "discount_counted": {
      "type": "boolean",
      "title": "Discount counted",
      "default": false
    },
    "stock_committed": {
      "type": "boolean",
      "title": "Inventory deducted",
      "default": false
    },
    "secured": {
      "type": "boolean",
      "title": "Financials verified server-side",
      "default": false
    },
    "city": {
      "type": "string",
      "title": "City"
    },
    "customer_name": {
      "type": "string",
      "title": "Customer Name"
    },
    "customer_email": {
      "type": "string",
      "title": "Customer Email"
    },
    "address": {
      "type": "string",
      "title": "Address"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "payment_method": {
      "type": "string",
      "title": "Payment Method",
      "enum": [
        "card",
        "cod",
        "loyalty"
      ]
    },
    "payment_status": {
      "type": "string",
      "title": "Payment status",
      "enum": [
        "unpaid",
        "paid",
        "refunded",
        "failed"
      ],
      "default": "unpaid"
    },
    "gift_message": {
      "type": "string",
      "title": "Gift Message"
    },
    "delivery_notes": {
      "type": "string",
      "title": "Delivery instructions"
    },
    "internal_notes": {
      "type": "string",
      "title": "Internal notes"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "handled_by": {
      "type": "string",
      "title": "Handled by (email)"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "default": "new",
      "enum": [
        "new",
        "confirmed",
        "preparing",
        "ready",
        "out_for_delivery",
        "delivered",
        "cancelled",
        "on_hold",
        "failed_delivery",
        "return_requested",
        "return_approved",
        "returned",
        "exchange_requested",
        "exchange_approved",
        "pending",
        "paid",
        "shipped"
      ]
    },
    "activity": {
      "type": "array",
      "title": "Activity log",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "by": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "customer_name",
    "customer_email",
    "address",
    "phone",
    "payment_method",
    "city"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}