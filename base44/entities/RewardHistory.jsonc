{
  "name": "RewardHistory",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "Customer ID"
    },
    "user_email": {
      "type": "string",
      "title": "Customer email"
    },
    "source": {
      "type": "string",
      "title": "Source",
      "enum": [
        "challenge",
        "wheel",
        "firsttime",
        "photo_review"
      ],
      "default": "challenge"
    },
    "source_id": {
      "type": "string",
      "title": "Source record"
    },
    "source_name": {
      "type": "string",
      "title": "Source name"
    },
    "reward_type": {
      "type": "string",
      "title": "Reward type"
    },
    "reward_label": {
      "type": "string",
      "title": "Reward label"
    },
    "points": {
      "type": "integer",
      "title": "Points",
      "default": 0
    },
    "discount_code": {
      "type": "string",
      "title": "Discount code"
    },
    "product_id": {
      "type": "string",
      "title": "Product"
    },
    "amount": {
      "type": "number",
      "title": "Monetary value",
      "default": 0
    },
    "fulfillment": {
      "type": "string",
      "title": "Fulfillment",
      "enum": [
        "auto",
        "manual"
      ],
      "default": "auto"
    }
  },
  "required": [
    "user_email",
    "source",
    "reward_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}