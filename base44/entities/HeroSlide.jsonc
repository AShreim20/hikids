{
  "name": "HeroSlide",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "subtitle": {
      "type": "string",
      "title": "Subtitle"
    },
    "image_url": {
      "type": "string",
      "title": "Image URL",
      "format": "uri"
    },
    "cta_label": {
      "type": "string",
      "title": "Button label"
    },
    "cta_link": {
      "type": "string",
      "title": "Button link"
    },
    "sort_order": {
      "type": "integer",
      "title": "Order",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    }
  },
  "required": [
    "image_url"
  ],
  "rls": {
    "read": null,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}