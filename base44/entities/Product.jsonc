{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "price": {
      "type": "number",
      "title": "Price"
    },
    "sale_price": {
      "type": "number",
      "title": "Sale Price"
    },
    "unit_cost": {
      "type": "number",
      "title": "Unit Cost"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "age_range": {
      "type": "string",
      "title": "Age Range"
    },
    "image_url": {
      "type": "string",
      "title": "Image URL",
      "format": "uri"
    },
    "images": {
      "type": "array",
      "title": "Gallery images",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "video_url": {
      "type": "string",
      "title": "Video URL",
      "format": "uri"
    },
    "material": {
      "type": "string",
      "title": "Material"
    },
    "rating": {
      "type": "number",
      "title": "Rating"
    },
    "stock": {
      "type": "integer",
      "title": "Stock"
    },
    "featured": {
      "type": "boolean",
      "title": "Featured",
      "default": false
    },
    "loyalty_exempt": {
      "type": "boolean",
      "title": "Does not earn loyalty points",
      "default": false
    },
    "tags": {
      "type": "array",
      "title": "Tags",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "options": {
      "type": "array",
      "title": "Options",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                },
                "images": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "variants": {
      "type": "array",
      "title": "Variant combinations",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "attributes": {
            "type": "object",
            "additionalProperties": true
          },
          "price": {
            "type": "number"
          },
          "cost": {
            "type": "number"
          },
          "compare_price": {
            "type": "number"
          },
          "stock": {
            "type": "integer"
          },
          "sku": {
            "type": "string"
          },
          "barcode": {
            "type": "string"
          },
          "weight": {
            "type": "number"
          },
          "active": {
            "type": "boolean",
            "default": true
          }
        }
      }
    }
  },
  "required": [
    "name",
    "price",
    "category",
    "image_url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}