{
  "name": "DiscountCode",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "title": "Code"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "type": {
      "type": "string",
      "title": "Type",
      "enum": [
        "percent",
        "fixed"
      ],
      "default": "percent"
    },
    "value": {
      "type": "number",
      "title": "Value",
      "default": 0
    },
    "min_subtotal": {
      "type": "number",
      "title": "Min subtotal",
      "default": 0
    },
    "usage_limit": {
      "type": "integer",
      "title": "Usage limit"
    },
    "used_count": {
      "type": "integer",
      "title": "Used count",
      "default": 0
    },
    "expires_at": {
      "type": "string",
      "title": "Expires at",
      "format": "date"
    },
    "active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    }
  },
  "required": [
    "code",
    "type",
    "value"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}