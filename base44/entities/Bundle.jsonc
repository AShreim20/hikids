{
  "name": "Bundle",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 2000
    },
    "image_url": {
      "type": "string",
      "title": "Image URL",
      "format": "uri"
    },
    "items": {
      "type": "array",
      "title": "Bundle items",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "image_url": {
            "type": "string",
            "format": "uri"
          },
          "unit_price": {
            "type": "number"
          },
          "quantity": {
            "type": "integer"
          }
        }
      }
    },
    "bundle_price": {
      "type": "number",
      "title": "Bundle selling price"
    },
    "discount_percent": {
      "type": "number",
      "title": "Discount percent",
      "default": 0
    },
    "start_date": {
      "type": "string",
      "title": "Start date",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "title": "End date",
      "format": "date"
    },
    "active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    },
    "sort_order": {
      "type": "integer",
      "title": "Sort order",
      "default": 0
    }
  },
  "required": [
    "name",
    "bundle_price"
  ],
  "rls": {
    "read": null,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}